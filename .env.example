# Server runtime configuration. Copy this file to .env and fill values locally.
# Supabase Dashboard: Connect (Project URL), Settings > API Keys (publishable key).
NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Use an sb_publishable_... key, NEVER a secret/service_role key.
# These values are not privileged, but this app keeps database access on the server.
# Existing NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names
# are also read when Nuxt loads its config. Use NUXT_* for production runtime overrides.
